// EXPECT: ok
//OUT: 1
//OUT: 10
//OUT: 2
//OUT: 15
//OUT: 7
//OUT: 14

// A closure variable keeps the fn type of its first arrow fn: it may be
// reassigned another closure of the same signature, or one that arrives
// as any (checked at runtime).
fn make(n: int) { return (x) => x + n; }
fn f() {
    var k <- (x) => x;
    print(k(1));
    k <- (x) => x * 10;
    print(k(1));
    var m <- (a: int) => a + 1;
    print(m(1));
    m <- make(10);
    print(m(5));
}
f();
var g <- (x) => x;
print(g(7));
if (true) { g <- (x) => x * 2; }
print(g(7));
