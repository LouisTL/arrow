// A keyword in a name slot (or in value position) is reported by name,
// once per statement, with the statement parsed to its end so nothing
// cascades — identically on both hosts.
fn fn() { return 1; }
var while <- 3;
fn g(if) { return 1; }
var h <- (var) => 1;
for (for in [1, 2]) { print(1); }
var p <- {return: 1};
print(q.import);
type match <- {a: int};
var r: else <- 1;
var true <- 2;
print(print);
