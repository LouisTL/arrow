// EXPECT: type_fail
//ERR: re-declaration of 'x' changes its type from int to str
//ERR: cannot assign str to 'n' of type int
//ERR: re-declaration of 'p' changes its type from int to str
//ERR: 3 type error(s)

// A for-loop variable is a declaration at the element type of its
// iterable, so it follows the same rules as `var`: one type per name
// per function (the shadowing rule) and no reassignment to another type
// (the fixed-type rule).
fn two_loops() {
    for (x in [1, 2]) { print(x + 1); }
    var words: [str] <- ["a", "b"];
    for (x in words) { print(x + "!"); }
}
fn retype_in_body() {
    var ints: [int] <- [1, 2];
    for (n in ints) { n <- "s"; print(n); }
}
fn loop_over_param(p: int) {
    for (p in ["a"]) { print(p); }
    print(p);
}
two_loops();
retype_in_body();
loop_over_param(1);
