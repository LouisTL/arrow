// EXPECT: ok
// cells(xs) copies a raw-layout array into a [any] array; the source is
// untouched and an already-[any] array copies as it is.
fn first<T>(xs: [T]): T { return xs[0]; }
fn count<T>(xs: [T]): int { return len(xs); }
var raw: [int] <- [10, 20, 30];
var cs <- cells(raw);
print(first(cs));
print(count(cs));
print(cs);
//OUT: 10
//OUT: 3
//OUT: [10, 20, 30]
push(cs, 40);
print(len(cs));
print(len(raw));
//OUT: 4
//OUT: 3
var words: [str] <- ["x", "y"];
print(first(cells(words)));
//OUT: x
var already <- [];
push(already, 1.5);
print(first(cells(already)));
//OUT: 1.5
