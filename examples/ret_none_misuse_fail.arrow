// EXPECT: type_fail
//ERR: 'x' annotated as int but assigned none
//ERR: argument 1 expected int but got none
//ERR: none cannot be used with '+'; only = and != test none
//ERR: 3 type error(s)

// ONETIER dial + DELTA-1: a fn that never returns a value returns
// none; its result unifies only with none and T | none. Misuse at
// concrete edges and in arithmetic is an ordinary type error.

fn quiet(s: str) { print(s); }
fn wants(p: int): int { return p; }
var x: int <- quiet("a");
print(wants(quiet("b")));
print(quiet("c") + 1);
